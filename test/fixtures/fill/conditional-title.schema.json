{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Long titles, but only on concept pages",
  "type": "object",
  "properties": {
    "title": { "type": "string" }
  },
  "if": {
    "required": ["type"],
    "properties": { "type": { "const": "concept" } }
  },
  "then": {
    "properties": { "title": { "minLength": 20 } }
  }
}
