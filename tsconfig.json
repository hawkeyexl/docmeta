{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Added after review found a write-only `billedCalls` left behind when the
    // cost-budget machinery was removed. `strict` does not cover it, so the
    // class was only findable by grep — which is not a check anyone runs.
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "verbatimModuleSyntax": false,
    // TODO: remove once tsup stops injecting the deprecated `baseUrl` during
    // its DTS bundle pass. This silences TS 6.0-promoted deprecations
    // project-wide, so re-check the build emits no other deprecation warnings
    // when dropping it.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "test"]
}
